        "parameters": {
            "core--router--parameters--path_user": {
                "name": "user",
                "in": "path",
                "description": "The user identifier.\n\nThis can be the magic string 'current', or the user's id, idnumber, or username.\n\nIf specifying an id, the value should be in the format `id:[id]`.\n\nIf specifying an idnumber, the value should be in the format `idnumber:[idnumber]`.\n\nIf specifying a username, the value should be in the format `username:[username]`.",
                "schema": {
                    "type": "string",
                    "pattern": "^(current|\\d+|idnumber:.+|username:.+)$"
                },
                "examples": {
                    "The current user": {
                        "value": "current"
                    },
                    "A user specified by their user id": {
                        "value": "94853"
                    },
                    "A user specified by their idnumber": {
                        "value": "idnumber:some-student-idnumber               "
                    },
                    "A user specified by their username": {
                        "value": "username:lyona1"
                    }
                },
                "required": true
            },
            "core--router--parameters--path_themename": {
                "name": "themename",
                "in": "path",
                "description": "The name of a Moodle theme.",
                "schema": {
                    "type": "string",
                    "pattern": "^[a-zA-Z0-9_\\-]*$"
                },
                "examples": {
                    "The Boost theme": {
                        "value": "boost"
                    },
                    "The Classic theme": {
                        "value": "classic"
                    }
                },
                "required": true
            },
            "core--router--parameters--path_component": {
                "name": "component",
                "in": "path",
                "description": "The name of a Moodle component, in frankenstyle format.",
                "schema": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9]*(_(?:[a-z][a-z0-9_](?!__))*)?[a-z0-9]+$"
                },
                "examples": {
                    "The core subsystem": {
                        "value": "core"
                    },
                    "The Course subsystem": {
                        "value": "core_course"
                    },
                    "An activity module": {
                        "value": "mod_assign"
                    },
                    "An assignment subplugin": {
                        "value": "assignsubmission_file"
                    }
                },
                "required": true
            },
            "core--router--parameters--header_language": {
                "name": "language",
                "in": "header",
                "description": "The language of the requested response.",
                "schema": {
                    "type": "string"
                },
                "examples": {
                    "Site default": {},
                    "English": {
                        "value": "en"
                    },
                    "Deutsch (kids)": {
                        "value": "de_kids"
                    }
                }
            }
        },
